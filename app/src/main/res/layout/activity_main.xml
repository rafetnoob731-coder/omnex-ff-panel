<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient_main"
    android:padding="20dp">

    <TextView
        android:id="@+id/logoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚡ OMNEX FF PANEL ⚡"
        android:textColor="#FF0000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="20dp"
        android:letterSpacing="0.1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FREE FIRE MOD MENU"
        android:textColor="#888888"
        android:textSize="12sp"
        android:gravity="center"
        android:paddingBottom="10dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏳ Waiting for permissions..."
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:gravity="center"
        android:padding="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="5dp">

        <LinearLayout
            android:id="@+id/permissionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1A1A1A"
            android:padding="10dp" />

    </ScrollView>

    <Button
        android:id="@+id/btnShizuku"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="🔧 OPEN SHIZUKU"
        android:textColor="#FFFFFF"
        android:backgroundTint="#333333"
        android:textSize="13sp"
        android:layout_marginTop="15dp"
        android:padding="15dp" />

    <Button
        android:id="@+id/btnLaunch"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="🚀 LAUNCH FREE FIRE"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC0000"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="10dp"
        android:padding="15dp" />

</LinearLayout>